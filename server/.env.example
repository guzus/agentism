# Use a disposable Neon database for development; never use production for tests.
DATABASE_URL=
SITE_URL=http://localhost:3000
PORT=3001
ADMIN_PASSWORD=
# Required for encrypting stored SSH private keys, not admin sessions.
SSH_KEY_ENCRYPTION_SECRET=
# Disable paid commands and automated participation during local development.
DISABLE_BACKGROUND_JOBS=true
# Optional browser origins, comma separated; overrides SITE_URL defaults.
CORS_ORIGIN=http://localhost:3000
# TREASURY_ADDRESS=0x...
# X_AUTH_TOKEN=
# X_CT0=
