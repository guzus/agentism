{
  "name": "openclaw-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@hono/node-server": "^1.19.17",
    "@steipete/bird": "^0.8.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "pg": "^8.23.0",
    "sshpk": "^1.18.0",
    "uuid": "^14.0.2",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/sshpk": "^1.17.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0 <25"
  },
  "packageManager": "npm@11.14.0"
}
